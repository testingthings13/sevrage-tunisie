# ============================================================
#  sevrage-tunisie.com — hébergement Namecheap Stellar (cPanel)
# ============================================================

DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

# ── Une seule adresse : https, sans www ─────────────────────
RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://sevrage-tunisie.com%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# /index.html renvoie sur / — sinon Google voit deux pages identiques
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# ── Compression ─────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
      application/javascript application/json image/svg+xml font/woff2
</IfModule>

# ── Cache : les fichiers versionnés (?v=) peuvent durer un an ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 month"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.(css|js|woff2|jpe?g|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

AddType font/woff2 .woff2
AddType image/svg+xml .svg

# ── Pages de travail : jamais en ligne ──────────────────────
<FilesMatch "^(logos|logo-derive)\.html$">
  Require all denied
</FilesMatch>
