# ============================================================
#  psychiatrie-sevrage.com — hébergement Namecheap Stellar (cPanel)
#  (compte hébergé sous sevrage-tunisie.com ; le site vit sur
#   psychiatrie-sevrage.com, l'adresse canonique unique)
# ============================================================

DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

# ── Une seule adresse : https://psychiatrie-sevrage.com, sans www ──
RewriteEngine On

# Défis ACME (Let's Encrypt) : servis tels quels, sans aucune redirection.
RewriteRule ^\.well-known/acme-challenge/ - [L]

# Vérification Google Search Console de psychiatrie-tunisie.com : ce fichier
# est servi tel quel, sans redirection, quel que soit le domaine appelé.
RewriteRule ^googlee08894d3466a510f\.html$ - [L]

# psychiatrie-tunisie.com — domaine sœur : 301 vers le site principal.
# La racine mène à la page Psychiatrie, le reste garde son chemin.
RewriteCond %{HTTP_HOST} ^(www\.)?psychiatrie-tunisie\.com$ [NC]
RewriteRule ^$ https://psychiatrie-sevrage.com/psychiatrie.html [L,R=301]
RewriteCond %{HTTP_HOST} ^(www\.)?psychiatrie-tunisie\.com$ [NC]
RewriteRule ^ https://psychiatrie-sevrage.com%{REQUEST_URI} [L,R=301]

# sevrage-tunisie.com — l'ancien nom : 301, le chemin est conservé.
RewriteCond %{HTTP_HOST} ^(www\.)?sevrage-tunisie\.com$ [NC]
RewriteRule ^ https://psychiatrie-sevrage.com%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://psychiatrie-sevrage.com%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# /index.html renvoie sur / — sinon Google voit deux pages identiques
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# L'ancienne page « crise » vit désormais sur l'accueil — [NE] préserve le #ancre.
# (psychiatrie.html est redevenue une vraie page : ne plus la rediriger.)
RewriteRule ^crise-psychiatrique\.html$ /#crise [R=301,NE,L]

# ── Compression ─────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
      application/javascript application/json image/svg+xml font/woff2
</IfModule>

# ── Cache : les fichiers versionnés (?v=) peuvent durer un an ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 month"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.(css|js|woff2|jpe?g|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

AddType font/woff2 .woff2
AddType image/svg+xml .svg

# ── Pages de travail : jamais en ligne ──────────────────────
<FilesMatch "^(logos|logo-derive)\.html$">
  Require all denied
</FilesMatch>

# Le journal des demandes contient des données personnelles.
<FilesMatch "^demandes\.log$">
  Require all denied
</FilesMatch>
