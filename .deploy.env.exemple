# Copiez ce fichier en .deploy.env et remplissez les deux premières lignes.
# N'y mettez JAMAIS le mot de passe : deploy.sh le demande au lancement.

# Le NOM DU SERVEUR cPanel, pas le domaine : le certificat FTPS est émis
# pour le serveur. Visible dans cPanel → Server Information.
FTP_HOST=server173-3.web-hosting.com
FTP_USER=votre_identifiant_cpanel
FTP_DIR=/public_html

# Mettre à 1 seulement si le certificat FTPS est refusé.
FTP_INSECURE=0
